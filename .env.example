# Frontend-safe: public to the browser; RLS must protect every exposed table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only elevated key: never prefix NEXT_PUBLIC_, commit, or expose it.
SUPABASE_SECRET_KEY=sb_secret_replace_me
RATE_LIMIT_HMAC_SECRET=replace_with_at_least_32_random_bytes

# Site and legal configuration. Use the exact approved consent version.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LEGAL_CONSENT_VERSION=

# Transactional email through Resend (optional until domain verification).
RESEND_API_KEY=
EMAIL_FROM=EXIN Grupo <notificaciones@example.com>
INQUIRY_NOTIFICATION_EMAIL=

# Cloudflare Turnstile. Configure both keys together to enforce bot checks.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
